@startuml communication-flow
title BEACON - Communication Architecture

left to right direction

actor Admin
actor "Probe Agent" as probe

package "Central Server" {
  rectangle "GraphQL API" as gql
  rectangle "Plugin Bundle Endpoint\n/plugins/{pluginId}/{version}/bundle" as bundles
  rectangle "Metrics Export\n/metrics" as metrics
  rectangle "Monitoring Endpoint\n/monitoring/grafana/embed-session" as mon
  rectangle "PostgreSQL" as pg
  rectangle "Redis Metrics Store" as redis
  rectangle "Plugin Dashboard Sync Service" as sync
}

package "Monitoring Stack" {
  rectangle "Prometheus" as prom
  rectangle "Grafana" as graf
}

cloud "Site Wi-Fi / Network Targets" as targets

Admin --> gql : Admin queries and mutations\nfleet, plugins, assignments, actions
probe --> gql : probeConfig, probeRuntime,\nrecordProbeHeartbeat,\npendingProbeActions,\nreportProbeMetrics,\nupdateProbeActionStatus
probe --> bundles : Download assigned plugin bundles
probe --> targets : Execute scheduled and action plugins

gql --> pg : Read and write probe,\nplugin, assignment, and action state
gql --> redis : Store latest probe metric snapshots
metrics --> redis : Read aggregated samples

prom --> metrics : Scrape central metrics
graf --> prom : Query time-series data
Admin --> graf : Open dashboards and embeds

Admin --> mon : Request dashboard embed
sync --> graf : Import plugin dashboards during\nplugin registration only

@enduml

@startuml
title Use Case - Auto Register Probe (RecordProbeHeartbeatUseCase)

autonumber

actor "Probe Agent" as probe
boundary "GraphQL Mutation\nrecordProbeHeartbeat" as gql
control "RecordProbeHeartbeatUseCase" as uc
control "ProbeRuntimeCoordinator" as runtime
database "IProbeRepository" as probes
database "PostgreSQL" as db

probe -> gql : recordProbeHeartbeat(input)
gql -> uc : ExecuteAsync(input)
uc -> runtime : RecordHeartbeatAsync(input)
runtime -> probes : GetByIdAsync(probeId)
probes -> db : SELECT probe by id
db --> probes : no row
probes --> runtime : null
runtime -> runtime : Create Probe + record passive heartbeat
runtime -> probes : RegisterAsync(new Probe)
probes -> db : INSERT probe
db --> probes : inserted
probes --> runtime : Probe
runtime --> uc : Probe, autoRegistered=true
uc --> gql : ProbeHeartbeatResponse
gql --> probe : success + runtime snapshot

@enduml

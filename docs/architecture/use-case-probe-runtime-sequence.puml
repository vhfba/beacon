@startuml
title Use Case - Get Probe Runtime (GetProbeRuntimeUseCase)

autonumber

actor "Probe Agent" as probe
boundary "GraphQL Query\nprobeRuntime" as gql
control "GetProbeRuntimeUseCase" as uc
database "IProbeRepository" as probes
database "IProbeTestConfigurationRepository" as configs
database "PostgreSQL" as db

probe -> gql : probeRuntime(probeId)
gql -> uc : ExecuteAsync(probeId)
uc -> probes : GetByIdAsync(probeId)
probes -> db : SELECT probe by id
db --> probes : probe row
probes --> uc : Probe
uc -> configs : GetEnabledByProbeIdAsync(probeId)
configs -> db : SELECT enabled tests
db --> configs : config rows
configs --> uc : ProbeTestConfiguration list
uc -> uc : Derive canEmitMetrics from\nprobe status and enabled tests
uc --> gql : ProbeRuntimeDTO
gql --> probe : ProbeRuntimeType

@enduml

@startuml use-cases-diagram
title BEACON - Use Cases

left to right direction

actor Admin as admin
actor "Probe agent" as probe
actor Prometheus as prom
actor Grafana as graf

rectangle "Central server" as central {
  usecase "Register probe" as UC_Register
  usecase "Register plugin" as UC_RegPlugin
  usecase "Assign plugins to probe" as UC_Assign
  usecase "View fleet status" as UC_Fleet
  usecase "Enable / disable tests" as UC_Enable
  usecase "Set schedule interval" as UC_Schedule
  usecase "Set probe status" as UC_Status
  usecase "Trigger on-demand action" as UC_Action
  usecase "Review action history" as UC_History

  usecase "Poll configuration" as UC_Poll
  usecase "Poll runtime eligibility" as UC_Runtime
  usecase "Send heartbeat" as UC_Heartbeat
  usecase "Poll pending actions" as UC_Pending
  usecase "Report metrics" as UC_Metrics
  usecase "Update action status" as UC_ActionStatus
  usecase "Fetch plugin bundle" as UC_Plugin

  usecase "Export aggregated metrics" as UC_Export
  usecase "Open Grafana embed session" as UC_Embed
  usecase "Import plugin dashboards" as UC_DashSync
}

rectangle "Monitoring stack" as monitoring {
  usecase "View dashboards" as UC_Dash
}

admin --> UC_Register
admin --> UC_RegPlugin
admin --> UC_Assign
admin --> UC_Fleet
admin --> UC_Enable
admin --> UC_Schedule
admin --> UC_Status
admin --> UC_Action
admin --> UC_History
admin --> UC_Embed
admin --> UC_DashSync
admin --> UC_Dash

probe --> UC_Poll
probe --> UC_Runtime
probe --> UC_Heartbeat
probe --> UC_Pending
probe --> UC_Metrics
probe --> UC_ActionStatus
probe --> UC_Plugin

prom --> UC_Export
graf --> UC_Dash

@enduml

@startuml
title Use Case - Set Probe Plugins (SetProbePluginsUseCase)

autonumber

actor Admin as admin
boundary "GraphQL Mutation\nsetProbePlugins" as gql
control "SetProbePluginsUseCase" as uc
database "IProbeRepository" as probes
database "IPluginRepository" as plugins
database "IProbePluginAssignmentRepository" as assignments
database "PostgreSQL" as db

admin -> gql : setProbePlugins(input)
gql -> uc : ExecuteAsync(input)
uc -> probes : GetByIdAsync(probeId)
probes -> db : SELECT probe
db --> probes : probe row
probes --> uc : Probe

loop For each requested pluginId
  uc -> plugins : GetByIdAsync(pluginId)
  plugins -> db : SELECT plugin
  db --> plugins : plugin row
  plugins --> uc : Plugin
end

uc -> assignments : SetForProbeAsync(probeId, pluginIds)
assignments -> db : REPLACE probe_plugin_assignments
db --> assignments : saved
uc -> assignments : GetByProbeIdAsync(probeId)
assignments -> db : SELECT assignments
db --> assignments : assignment rows
uc -> plugins : GetAllAsync()
plugins -> db : SELECT plugins
db --> plugins : plugin rows
uc --> gql : ProbePluginAssignmentDTO list
gql --> admin : SetProbePluginsResponse(success=true)

@enduml

@startuml
title BEACON - Plugin Execution Architecture

left to right direction

package "Probe Agent" {
  rectangle "Central Client" as client
  rectangle "Scheduler" as scheduler
  rectangle "Action Poller" as poller
  rectangle "Plugin Manager" as manager
  rectangle "Bundle Cache" as cache
  rectangle "Metrics Reporter" as reporter

  package "Scheduled Plugins" {
    rectangle "PING" as ping
    rectangle "HTTP" as http
    rectangle "IPERF" as iperf
    rectangle "WIFI" as wifi
  }

  package "Action Plugins" {
    rectangle "WIFI_SCAN_ACTION" as scan
  }
}

package "Central Server" {
  rectangle "GraphQL API" as gql
  rectangle "Bundle Endpoint" as bundles
}

cloud "Site Targets" as targets

client --> gql : probeConfig + probeRuntime
poller --> gql : pendingProbeActions
manager --> bundles : Download plugin zip archives
manager --> cache : Extract and load bundles

scheduler --> manager : Run due scheduled plugins
poller --> manager : Run queued action plugins

manager --> ping
manager --> http
manager --> iperf
manager --> wifi
manager --> scan

ping --> targets
http --> targets
iperf --> targets
wifi --> targets
scan --> targets

manager --> reporter : Normalized metrics and records
reporter --> gql : reportProbeMetrics + updateProbeActionStatus

@enduml

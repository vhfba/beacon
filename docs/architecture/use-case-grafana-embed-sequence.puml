@startuml
title Use Case - Create Grafana Embed Session

autonumber

actor Admin as admin
boundary "HTTP Endpoint\nPOST /monitoring/grafana/embed-session" as endpoint
control "MonitoringOptions" as options
control "IGrafanaDashboardClient" as grafana

admin -> endpoint : POST { site }
endpoint -> options : Read Grafana.DashboardBaseUid
options --> endpoint : base dashboard UID
endpoint -> grafana : BuildEmbedUrl(base dashboard UID, site)
grafana --> endpoint : embed URL
endpoint --> admin : embedUrl + dashboardUid

@enduml

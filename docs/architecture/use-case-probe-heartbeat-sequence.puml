@startuml use-case-probe-heartbeat-sequence
title Use Case - Record Probe Heartbeat (RecordProbeHeartbeatUseCase)

autonumber

actor "Probe Agent" as probe
boundary "GraphQL Mutation\nrecordProbeHeartbeat" as gql
control "RecordProbeHeartbeatUseCase" as heartbeat
control "ProbeRuntimeCoordinator" as coordinator
control "GetProbeRuntimeUseCase" as runtime
database "IProbeRepository" as probes
database "IProbeTestConfigurationRepository" as configs
database "PostgreSQL" as db

probe -> gql : recordProbeHeartbeat(input)
gql -> heartbeat : ExecuteAsync(input)
heartbeat -> coordinator : RecordHeartbeatAsync(input)
coordinator -> probes : GetByIdAsync(probeId)
probes -> db : SELECT probe by id
db --> probes : probe row or null
probes --> coordinator : Probe or null

alt Probe is unknown
  coordinator -> coordinator : Create Probe and record passive heartbeat
  coordinator -> probes : RegisterAsync(new Probe)
  probes -> db : INSERT probe
  db --> probes : inserted row
  probes --> coordinator : Probe
else Probe is decommissioned
  coordinator --> heartbeat : DomainException
  heartbeat --> gql : success=false
  gql --> probe : ProbeHeartbeatResponse(error)
else Probe exists
  coordinator -> coordinator : Update reported details\nand record passive heartbeat
  coordinator -> probes : UpdateAsync(probe)
  probes -> db : UPDATE heartbeat and details
  db --> probes : updated row
  probes --> coordinator : ok
end

heartbeat -> runtime : ExecuteAsync(probeId)
runtime -> probes : GetByIdAsync(probeId)
probes -> db : SELECT probe
db --> probes : probe row
runtime -> configs : GetEnabledByProbeIdAsync(probeId)
configs -> db : SELECT enabled tests
db --> configs : config rows
runtime --> heartbeat : ProbeRuntimeDTO
heartbeat --> gql : ProbeHeartbeatResultDTO
gql --> probe : ProbeHeartbeatResponse(success, autoRegistered, runtime)

@enduml

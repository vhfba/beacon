@startuml
title BEACON - Component Diagram (C3) - Central Server

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person(admin, "Admin")
Person_Ext(probe, "Probe Agent")
System_Ext(prom, "Prometheus", "Scrapes /metrics")
System_Ext(grafana, "Grafana", "Dashboard UI and HTTP API")

System_Boundary(central, "Central Server") {

  Boundary(presentation, "Presentation", "Layer") {
    Component(graphql, "GraphQL Resolvers", "HotChocolate", "Admin and probe queries and mutations")
    Component(security, "Auth + GraphQL Hardening", "ASP.NET Core middleware", "API key auth, authorization policies, and query guardrails")
    Component(bundleEndpoint, "Plugin Bundle Endpoint", "Minimal API endpoint", "Serves validated plugin zip archives")
    Component(monitoringEndpoints, "Monitoring Endpoints", "Minimal API endpoints", "/metrics export and Grafana embed session")
  }

  Boundary(application, "Application", "Layer") {
    Component(useCases, "Use Case Layer", "Application services", "Fleet, plugin, assignment, action, and metrics workflows")
    Component(runtimeCoordinator, "ProbeRuntimeCoordinator", "Application service", "Auto-registers probes and records passive heartbeat updates")
    Component(dashboardAutomation, "PluginDashboardAutomationService", "Application service", "Validates and imports plugin-provided dashboard JSON")
  }

  Boundary(infrastructure, "Infrastructure", "Layer") {
    Component(repositories, "Repository Adapters", "EF Core adapters", "Persist probes, plugins, assignments, and action executions in PostgreSQL")
    Component(metricsStore, "Probe Metrics Store", "Redis or in-memory adapter", "Stores latest probe-reported metric snapshots")
    Component(grafanaSync, "GrafanaDashboardSyncService", "HTTP client adapter", "Imports or updates Grafana dashboards")
  }

  Component(db, "PostgreSQL", "Relational database", "Primary persistence")
  Component(redis, "Redis", "Key-value store", "Metric snapshot cache with TTL")
}

Rel(admin, security, "Authenticated admin access", "HTTP")
Rel(probe, security, "Authenticated probe access", "HTTP")
Rel(security, graphql, "Authorizes GraphQL requests")
Rel(graphql, useCases, "Execute queries and mutations")
Rel(graphql, runtimeCoordinator, "Heartbeat workflow")
Rel(bundleEndpoint, repositories, "Validate plugin metadata and availability")
Rel(monitoringEndpoints, metricsStore, "Export aggregated metrics")
Rel(monitoringEndpoints, grafanaSync, "Ensure site dashboards and build embed URLs")

Rel(runtimeCoordinator, repositories, "Read/write probe state")
Rel(useCases, repositories, "Persist domain state")
Rel(useCases, metricsStore, "Store or read metric snapshots")
Rel(useCases, dashboardAutomation, "Apply plugin dashboard automation during plugin workflows")
Rel(dashboardAutomation, grafanaSync, "Upsert Grafana dashboards")

Rel(repositories, db, "Read/write")
Rel(metricsStore, redis, "Read/write snapshots")
Rel(grafanaSync, grafana, "Grafana HTTP API")

Rel(prom, monitoringEndpoints, "Scrape /metrics", "HTTP GET")
Rel(probe, bundleEndpoint, "Download plugin bundles")
Rel(probe, graphql, "Probe config, runtime, heartbeat, actions, and metrics")

@enduml

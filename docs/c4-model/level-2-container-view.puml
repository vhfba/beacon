@startuml
title BEACON - Container Diagram (C2)

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(admin, "Admin")
System_Ext(targets, "Site Wi-Fi and Network Targets", "Endpoints exercised by probe plugins")

System_Boundary(beacon, "BEACON Platform") {
  Container(central, "Central Server", ".NET 9 / ASP.NET Core / HotChocolate", "GraphQL control plane, plugin bundle delivery, metrics export, and monitoring integration")
  ContainerDb(postgres, "Primary Data Store", "PostgreSQL", "Stores probes, plugins, assignments, action executions, and test configuration")
  ContainerDb(redis, "Metrics Snapshot Store", "Redis", "Stores latest per-probe metric snapshots for central export")
  Container(agent, "Probe Agent", "Python", "Polls config, downloads plugins, executes checks, sends heartbeat, reports metrics, and processes actions")
  Container(prom, "Prometheus", "Prometheus", "Scrapes central-server /metrics and evaluates rules")
  Container(graf, "Grafana", "Grafana", "Dashboards, embeds, and plugin-provided visualizations")
}

Rel(admin, central, "Manage fleet and control runtime", "GraphQL + HTTP")
Rel(admin, graf, "View dashboards", "Browser")

Rel(agent, central, "GraphQL runtime operations and plugin bundle download", "HTTP")
Rel(agent, targets, "Run scheduled and action checks")

Rel(central, postgres, "Read/write domain state")
Rel(central, redis, "Store and export latest metric snapshots")
Rel(prom, central, "Scrape /metrics", "HTTP GET")
Rel(graf, prom, "Execute PromQL queries", "HTTP")
Rel(central, graf, "Synchronize dashboards and build embed URLs", "Grafana HTTP API")

note bottom of central
  Central-server is the control plane and the
  single Prometheus scrape target for BEACON metrics.
end note

@enduml

@startuml
title BEACON - Component Diagram (C3) - Probe Agent

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person_Ext(operator, "Admin")
System_Ext(central, "Central Server", "GraphQL control plane, bundle delivery, and metrics export")
System_Ext(targets, "Site Wi-Fi and Network Targets", "Endpoints exercised by plugins")

System_Boundary(agentSystem, "Probe Agent") {
  Container_Boundary(agent, "Probe Agent Runtime") {
    Component(client, "Central Client", "Python HTTP/GraphQL client", "Calls probeConfig, probeRuntime, heartbeat, action, and metrics operations")
    Component(pluginManager, "Plugin Manager", "Bundle cache and loader", "Downloads, validates, extracts, and loads plugin bundles")
    Component(scheduler, "Scheduler", "Runtime loop", "Runs scheduled plugins on configured intervals")
    Component(actionPoller, "Action Poller", "Runtime loop", "Claims and runs pending action executions")
    Component(metricReporter, "Metrics Reporter", "Result mapper", "Transforms plugin output into central metric payloads")
    Component(localApi, "Local Inspection API", "HTTP endpoints", "Exposes /health and local debug endpoints")
  }

  Component(scheduledPlugins, "Scheduled Plugins", "Python plugin contract", "PING, HTTP, IPERF, WIFI")
  Component(actionPlugins, "Action Plugins", "Python plugin contract", "WIFI_SCAN_ACTION and future on-demand plugins")
}

Rel(operator, localApi, "Inspect local runtime state", "HTTP")
Rel(client, central, "GraphQL runtime operations", "HTTP")
Rel(pluginManager, central, "Download plugin bundles", "HTTP")
Rel(scheduler, pluginManager, "Resolve due scheduled plugins")
Rel(actionPoller, pluginManager, "Resolve queued action plugins")
Rel(pluginManager, scheduledPlugins, "Load and execute")
Rel(pluginManager, actionPlugins, "Load and execute")
Rel(scheduledPlugins, targets, "Run checks against targets")
Rel(actionPlugins, targets, "Run on-demand diagnostics")
Rel(scheduledPlugins, metricReporter, "Return metrics and records")
Rel(actionPlugins, metricReporter, "Return metrics, record, and status")
Rel(metricReporter, client, "reportProbeMetrics and updateProbeActionStatus")

@enduml
